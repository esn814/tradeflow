{
  "name": "tradeflow-server",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node dist/server.cjs",
    "dev": "node --watch index.js",
    "build": "esbuild index.js --bundle --platform=node --target=node18 --format=cjs --outfile=dist/server.cjs --external:express --external:cors --external:helmet --external:cookie-parser --external:pino-http --external:express-rate-limit --external:@sentry/node --external:better-sqlite3 --external:jsonwebtoken --external:pino --external:pino-pretty --external:siwe --external:web-push --external:zod --external:sql.js --sourcemap"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "pino-pretty": "^13.0.0",
    "siwe": "^3.0.0",
    "sql.js": "^1.14.1",
    "web-push": "^3.6.7",
    "zod": "^4.4.3",
    "esbuild": "^0.28.0"
  },
  "type": "module",
  "devDependencies": {}
}
