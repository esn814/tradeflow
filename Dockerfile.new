# === Stage 1: Build ===
FROM node:18-alpine AS build

WORKDIR [internal] package.json package-lock.json* .[internal] server/package.json server/package-lock.json* .[internal] cd server && npm install --legacy-peer-deps

COPY . .

RUN cd server && npm run build

# === Stage 2: Production ===
FROM node:18-alpine

WORKDIR [internal] package.json package-lock.json* .[internal] server/package.json server/package-lock.json* .[internal] cd server && npm install --legacy-peer-deps --omit=dev

COPY --from=build [internal] .[internal] mkdir -p [internal] 10000

CMD ["node", "server/dist/server.cjs"]
