# TradeFlow Environment Variables
# Copy to .env and fill in your values

# Required — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=

# Database
DB_PATH=/data/tradeflow.db

# CORS (comma-separated origins)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:5173

# VAPID (web push — generate at https://vapidkeys.github.io)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your@email.com

# Admin wallet addresses (comma-separated, for backup restore access)
ADMIN_ADDRESSES=0xYourWalletAddress

# Frontend env
VITE_API_URL=https://your-backend-url.onrender.com/api

# Optional
SENTRY_DSN=
BACKUP_RETENTION_DAYS=7
